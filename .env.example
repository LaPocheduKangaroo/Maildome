# MailShield — environment variables
# Copy to .env and fill in your values
# Never commit .env to git

# PostgreSQL
POSTGRES_DB=mailshield
POSTGRES_USER=mailshield
POSTGRES_PASSWORD=change_me_now

# Redis
REDIS_PASSWORD=change_me_now

# API
API_SECRET_KEY=change_me_now
API_TOKEN_EXPIRE_MINUTES=60

# Mail acquisition
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=

# Notifications
ADMIN_EMAIL=
