# MailDome — environment variables
# Copy to .env and fill in your values, OR run install.sh which generates it.
# Never commit .env to git.

# PostgreSQL
POSTGRES_DB=maildome
POSTGRES_USER=maildome
POSTGRES_PASSWORD=change_me_now

# Redis
REDIS_PASSWORD=change_me_now

# API bearer token (used by the Thunderbird plugin and any API clients)
API_TOKEN=change_me_now

# Mail acquisition
IMAP_PASSWORD=

# Optional: override config file path inside containers
# MAILSHIELD_CONFIG=/app/core/config/mailshield.conf

# Optional: mail domain forwarded to the Postfix container
# MAIL_DOMAIN=example.com
